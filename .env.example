# Base L2 AI Transaction Provider
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
EXECUTION_MODE=mock

# Prefer CHAIN_ID (84532 Sepolia / 8453 Mainnet) — overrides BASE_NETWORK
CHAIN_ID=84532
BASE_NETWORK=baseSepolia
BASE_RPC_URL=https://sepolia.base.org
BASE_RPC_URLS=

# Secrets
AGENT_PRIVATE_KEY=
PIMLICO_API_KEY=
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_SLUG=
TENDERLY_PROJECT_SLUG=
TENDERLY_REQUIRED=false
TENDERLY_MAX_DRAIN_USDC=500

# Optional explicit bundler overrides
BUNDLER_RPC_URL=
PAYMASTER_RPC_URL=
PAYMASTER_POLICY_ID=

# ZeroDev ERC-7579 session keys
ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=
ZERODEV_PAYMASTER_RPC=
SESSION_KEY_MODE=db
SESSION_KEY_MAX_USDC=50
SESSION_KEY_TTL_HOURS=24

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/base_ai_tx
REDIS_URL=redis://localhost:6380
API_KEYS=dev-agent-key
DEFAULT_MAX_SPEND_USDC=100
DEFAULT_ALLOWED_TARGETS=

PUBLIC_BASE_URL=
MCP_TRANSPORT=stdio

# x402 HTTP micropayment paywall (protects /v1/paid/*)
X402_ENABLED=false
X402_PRICE_USDC=0.01
X402_RECIPIENT=
X402_PATH_PREFIXES=/v1/paid
