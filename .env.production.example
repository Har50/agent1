# --- NETWORK CONFIGURATION ---
CHAIN_ID=8453
BASE_NETWORK=base
BASE_RPC_URL=https://mainnet.base.org
# RPC_FALLBACK_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
EXECUTION_MODE=live

# --- SMART CONTRACT ADDRESSES (BASE MAINNET) ---
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
PAYMASTER_TOPUP_CONTRACT=0x_YOUR_MAINNET_VAULT
# PAYMASTER_ADDRESS / PIMLICO paymaster policy set via Pimlico dashboard

# --- KEEPER DAEMON ---
KEEPER_PRIVATE_KEY=0x_DEDICATED_HOT_WALLET
KEEPER_POLL_SECONDS=30
# On-chain threshold/topUp set at deploy or via setThreshold/setTopUpAmount

# --- FASTIFY API & SAFETY ---
PORT=8787
HOST=0.0.0.0
DATABASE_URL=postgresql://user:pass@host/agentexec
REDIS_URL=rediss://default:token@host:6379
API_KEYS=replace-me

AGENT_PRIVATE_KEY=0x_AGENT_OWNER_EOA
PIMLICO_API_KEY=pim_...
TENDERLY_ACCESS_KEY=tend_...
TENDERLY_ACCOUNT_SLUG=your-org
TENDERLY_PROJECT_SLUG=agentexec
TENDERLY_REQUIRED=true
TENDERLY_MAX_DRAIN_USDC=500

SESSION_KEY_MODE=db
# ZERODEV_PROJECT_ID=

X402_ENABLED=true
X402_PRICE_USDC=0.01
X402_RECIPIENT=0x_TREASURY
X402_PATH_PREFIXES=/v1/paid

# SENTRY_DSN=https://key@o0.ingest.sentry.io/0
PUBLIC_BASE_URL=https://api.agentexec.io
